<?xml version="1.0" encoding="UTF-8"?>
<!--
    log4j2 配置：
    * Console 输出，带线程名和 logger 简名，方便观察 Publisher / Subscriber 线程交互
    * 默认 INFO；Aeron 内部日志设为 WARN 避免刷屏
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <!--
                %F / %L 需要 log4j 通过栈帧解析源码位置，有一定性能开销，
                学习/调试场景无所谓；线上高吞吐场景建议去掉。
                IntelliJ Console 识别 (FileName.java:line) 这个形态自动变成可点击链接。
            -->
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{1} (%F:%L) - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <!-- Aeron / Agrona 内部日志：太吵，压到 WARN -->
        <Logger name="io.aeron" level="WARN"/>
        <Logger name="org.agrona" level="WARN"/>

        <!-- 应用 demo 日志 -->
        <Logger name="org.example" level="INFO"/>
        <Logger name="self" level="INFO"/>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
